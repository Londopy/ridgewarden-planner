[Unit]
Description=ridgewarden-planner, a network planner for AREDN meshes
Documentation=https://github.com/Londopy/ridgewarden-planner
After=network-online.target ridgewarden.service
Wants=network-online.target

[Service]
# its own user, in the core's group: it can read the core's local.token, not its station key
User=ridgewarden-planner
Group=ridgewarden-planner
SupplementaryGroups=ridgewarden
ExecStart=/usr/bin/ridgewarden-planner --config /etc/ridgewarden/planner.toml run
Restart=on-failure
RestartSec=10
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/ridgewarden-planner /var/lib/ridgewarden/imports /var/lib/ridgewarden/exports

[Install]
WantedBy=multi-user.target
